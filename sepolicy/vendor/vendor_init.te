set_prop(vendor_init, vendor_fingerprint_prop)
set_prop(vendor_init, vendor_nothing_feature_prop)
set_prop(vendor_init, vendor_qms_prop)
set_prop(vendor_init, vendor_ssr_prop)
get_prop(vendor_init, vendor_nfc_prop)
set_prop(vendor_init, vendor_nfc_prop)

allow vendor_init vendor_proc_display:dir r_dir_perms;
allow vendor_init vendor_proc_display:file { rw_file_perms setattr };
allow vendor_init vendor_proc_fingerprint:file { rw_file_perms setattr };
allow vendor_init vendor_proc_power_supply:dir r_dir_perms;
allow vendor_init vendor_proc_power_supply:file { rw_file_perms setattr };
allow vendor_init vendor_proc_touchpanel_gesture:file { rw_file_perms setattr };

allow vendor_init proc_sched_walt:file w_file_perms;
allow vendor_init vendor_sysfs_boot_log:file w_file_perms;
allow vendor_init vendor_sysfs_fingerprint:file { rw_file_perms setattr };
allow vendor_init vendor_sysfs_touch:file { rw_file_perms setattr };
