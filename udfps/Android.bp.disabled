cc_library_shared {
    name: "libudfpshandler",
    defaults: ["//hardware/nothing:nothing_hardware_biometrics_config_default"],
    vendor: true,
    srcs: ["UdfpsHandler.cpp"],
    init_rc: ["libudfpshandler.rc"],
    cflags: ["-DTARGET_USES_LHBM"],
    shared_libs: [
        "libbase",
    ],
    header_libs: [
        "//hardware/nothing:nothingfingerprint_headers",
    ],
}
