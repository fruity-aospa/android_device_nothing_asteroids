# eSE
/dev/st54spi    0660    secure_element    secure_element

# Fingerprint
/dev/goodix_fp    0660    system    system

# Lights
/dev/led_strips   0664   system   system

# Vibrator
/dev/aac_richtap   0660   system   system
/dev/ics_sfdc      0660   system   system

# Display mdss power control
/sys/devices/platform/soc/9800000.qcom,mdss_mdp power/control 0664 system graphics

# Entries from stock C5.0-261023-2146 vendor ueventd.rc missing in device/qcom/common
# FastRPC NSP/LPASS domains
/dev/fastrpc-nsp*         0644   system     system
/dev/fastrpc-lpass*       0644   system     system
/sys/kernel/fastrpc/nsp*   name          0444   root   system
/sys/kernel/fastrpc/nsp*   domain_id     0444   root   system
/sys/kernel/fastrpc/nsp*   instance_id   0444   root   system
/sys/kernel/fastrpc/nsp*   status        0444   root   system
/sys/kernel/fastrpc/nsp*   type          0444   root   system
/sys/kernel/fastrpc/nsp*   legacy_name   0444   root   system
/sys/kernel/fastrpc/nsp*   legacy_id     0444   root   system
/sys/kernel/fastrpc/lpass* name          0444   root   system
/sys/kernel/fastrpc/lpass* domain_id     0444   root   system
/sys/kernel/fastrpc/lpass* instance_id   0444   root   system
/sys/kernel/fastrpc/lpass* status        0444   root   system
/sys/kernel/fastrpc/lpass* type          0444   root   system
/sys/kernel/fastrpc/lpass* legacy_name   0444   root   system
/sys/kernel/fastrpc/lpass* legacy_id     0444   root   system

# Nothing partitions
/dev/block/platform/soc/1d84000.ufshc/by-name/binfo         0660   system   system
/dev/block/platform/soc/1d84000.ufshc/by-name/nt_reserve1   0660   system   system

# Secure element / power state / UWB
/dev/stsafe320_gpio       0660   system     system
/dev/power_state          0660   system     system
/dev/spiuwb               0660   uwb        uwb

# USB role
/sys/bus/platform/devices/a400000.ssusb    mode   0660   system   usb
/sys/bus/platform/devices/4e00000.ssusb    mode   0660   system   usb

# QPT power telemetry
/sys/devices/virtual/powercap/qpt/qpt\:*/*    name        0440   root   system
/sys/devices/virtual/powercap/qpt/qpt\:*/*    energy_uj   0440   root   system
/sys/devices/virtual/powercap/qpt/qpt\:*/*    power_uw    0440   root   system
